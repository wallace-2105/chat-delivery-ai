# ─── Servidor ─────────────────────────────────────────────────────────────

# Porta do servidor (Render define automaticamente, não precisa alterar)
PORT=3001

# Origem permitida pelo CORS — coloque a URL do seu Vercel em produção
# Ex.: https://meu-delivery.vercel.app
ALLOWED_ORIGIN=http://localhost:8080

# ─── Banco de dados (libsql / Turso) ──────────────────────────────────────

# Deixe VAZIO para usar arquivo local (orders.db) durante desenvolvimento.
# Em produção (Render + Turso) preencha com a URL e o token do seu banco Turso.
#
# Como obter:
#   1. Crie conta grátis em https://turso.tech
#   2. Crie um banco: turso db create delivery-ai
#   3. Pegue a URL:   turso db show delivery-ai --url
#   4. Pegue o token: turso db tokens create delivery-ai
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# ─── IA (opcional) ────────────────────────────────────────────────────────

# Sem isso, o sistema usa o parser por aliases do catálogo (sem custo).
# Preencha só se tiver acesso ao Amazon Bedrock.
# BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
# AWS_REGION=us-east-1

{
  "name": "delivery-ai-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/local-server.ts",
    "start": "tsx src/local-server.ts",
    "build": "esbuild src/handlers/*.ts --bundle --platform=node --target=node20 --outdir=dist --sourcemap",
    "build:server": "esbuild src/local-server.ts --bundle --platform=node --target=node20 --outfile=dist/local-server.cjs --sourcemap --external:@libsql/client",
    "start:prod": "node dist/local-server.cjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.900.0",
    "@aws-sdk/client-dynamodb": "^3.900.0",
    "@aws-sdk/client-sfn": "^3.900.0",
    "@aws-sdk/lib-dynamodb": "^3.900.0",
    "@libsql/client": "^0.17.4"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.152",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/node": "^22.16.5",
    "cors": "^2.8.5",
    "esbuild": "^0.25.10",
    "express": "^5.1.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
